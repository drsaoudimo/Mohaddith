# ===== نموذج الذكاء الاصطناعي =====
# المزوّد الافتراضي: Gemini (يمكن تبديله من زر المزوّد في الواجهة)
AI_PROVIDER=gemini

# ----- Gemini (المزوّد الافتراضي) -----
# مفتاح Gemini API — أنشئه من Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# (اختياري) نموذج Gemini، والافتراضي هو Gemini 3 Flash Preview
GEMINI_MODEL=gemini-3-flash-preview

# ----- بديل: Anthropic Claude Sonnet (عند اختياره من زر المزوّد) -----
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-sonnet-5-5
